/target
**/*.rs.bk
Cargo.lock

# Local RocksDB instances and benchmark output
/data/db/
/data/*.db/
/benchmarks/results/*
/results/

# Exception: results that prove a phase gate are committed, so a Rule 10
# [benchmark: file] citation points at a file that is actually in the repo.
# Routine runs stay ignored; copy one here only when it closes a gate.
# (The parent is excluded by its *contents* above, not as a directory, because
# git will not descend into an excluded directory to re-include anything.)
!/benchmarks/results/gate/

# Real clinical data must never be committed (Rule 6 / PRD 2.7)
/data/raw/
/data/idpip_export/
*.csv
*.parquet
!/benchmarks/traces/*.jsonl

# Full-scale traces are derived clinical data and run to hundreds of MB. The
# manifest beside each one carries the source and trace SHA-256, so a committed
# manifest is enough to prove which graph a benchmark number came from (Rule 10)
# without committing the records themselves. Regenerate with data/*_loader.py.
/benchmarks/traces/*_full.jsonl
!/benchmarks/traces/*.manifest.json

# ML artifacts. Training checkpoints stay ignored (bulky, reproducible from
# the trace + the trainer script); the small deployed model that Rule 3's
# gate checks for is committed, same reasoning as benchmarks/results/gate/.
/ml/checkpoints/
*.onnx
*.pt
!/ml/deployed/**/*.pt
__pycache__/
*.py[cod]
.venv/

# Secrets — encryption keys are never committed (Rule 8)
*.key
*.pem
!/infrastructure/certs/README.md
.env
