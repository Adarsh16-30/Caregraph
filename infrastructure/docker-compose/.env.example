# Copy to `.env` alongside dev-stack.yml. Local development only.
#
# These credentials protect throwaway baseline containers on localhost. They are
# NOT the at-rest encryption keys required by Rule 8 — those are managed
# separately and never live in a file under version control.

NEO4J_PASSWORD=caregraph-dev-only
NEO4J_HEAP=2G
TERMINUSDB_PASSWORD=caregraph-dev-only
GRAFANA_PASSWORD=caregraph-dev-only

RUST_LOG=caregraph=info

# Memory. Each of these is a ceiling for one container; CAREGRAPH_MEMORY_MB is the
# server's own budget for everything inside its container (RocksDB caches,
# memtables, and the Python embedding workers, about 450 MB each) and must fit
# under CAREGRAPH_CONTAINER_MEM. See docs/memory.md.
CAREGRAPH_CONTAINER_MEM=2g
CAREGRAPH_MEMORY_MB=1800
NEO4J_MEM_LIMIT=4g
TERMINUSDB_MEM_LIMIT=2g
PROMETHEUS_MEM_LIMIT=512m
GRAFANA_MEM_LIMIT=512m

# CPUs for each baseline container and its page cache (scripts/p10_compare.sh uses 4 / 1G).
BASELINE_CPUS=4
NEO4J_PAGECACHE=1G
